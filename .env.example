# Genera con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# True solo en desarrollo. En producción siempre False.
DEBUG=True

# Lista separada por comas, sin espacios. Ej: localhost,127.0.0.1,uneflix.com
ALLOWED_HOSTS=127.0.0.1,localhost

# Solo en producción con HTTPS. Orígenes de confianza para POST (con esquema),
# separados por comas. Sin esto, los formularios dan 403 CSRF en el dominio real.
# Ej: https://uneflix.com,https://www.uneflix.com
CSRF_TRUSTED_ORIGINS=

# --- Base de datos ---
# Si no se define, usa SQLite local (dev). En producción, pegá la URL de Postgres
# que te da el host. Ej: postgres://usuario:pass@host:5432/nombre_db
DATABASE_URL=

# --- Email (recuperación de contraseña) ---
# Por defecto imprime el correo en la consola (dev). Para mandar emails de verdad
# en producción, descomentá y completá con tu proveedor SMTP (ej. Gmail, SendGrid).
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=tucorreo@gmail.com
# EMAIL_HOST_PASSWORD=tu-app-password
# DEFAULT_FROM_EMAIL=Uneflix <no-reply@uneflix.com>