# Genera con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# True solo en desarrollo. En producción siempre False.
DEBUG=True

# Lista separada por comas, sin espacios. Ej: localhost,127.0.0.1,uneflix.com
ALLOWED_HOSTS=127.0.0.1,localhost

# Solo en producción con HTTPS. Orígenes de confianza para POST (con esquema),
# separados por comas. Sin esto, los formularios dan 403 CSRF en el dominio real.
# Ej: https://uneflix.com,https://www.uneflix.com
CSRF_TRUSTED_ORIGINS=